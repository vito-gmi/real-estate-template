# ---------------------------------------------------------------------------
# Estate Template — environment
# Copy to `.env.local` for development. Every value is validated in src/env.ts.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin, used for canonical URLs, sitemaps, OG images and auth callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database ---------------------------------------------------------------
# Local Docker Postgres (see `npm run docker:db`):
DATABASE_URL="postgres://estate:estate@localhost:5433/estate"
# Neon (production) — use the POOLED connection string:
# DATABASE_URL="postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/estate?sslmode=require"
DATABASE_MAX_CONNECTIONS="10"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-random-48-byte-base64-string-abcdefgh"

# --- Object storage ---------------------------------------------------------
# "local" writes to LOCAL_STORAGE_DIR and serves via /media (development only).
# "s3" targets any S3-compatible bucket — Cloudflare R2, AWS S3, MinIO.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".storage"

# Cloudflare R2 example:
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<account-id>.eu.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="estate-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"

# Private bucket for photos visitors send with "List your property" before staff
# review them. It must NOT be publicly readable (no custom domain, no r2.dev
# URL). Same endpoint and keys as S3_BUCKET. Without it the s3 driver keeps the
# submission form closed. See docs/property-submissions.md.
# S3_PRIVATE_BUCKET="estate-submissions"
# Local equivalent (STORAGE_DRIVER=local). Never served by /media.
LOCAL_PRIVATE_STORAGE_DIR=".storage-private"

# Public base URL that serves the bucket (R2 custom domain, or /media locally).
NEXT_PUBLIC_MEDIA_BASE_URL="/media"
# NEXT_PUBLIC_MEDIA_BASE_URL="https://images.example.bg"

# --- Email ------------------------------------------------------------------
# "console" prints messages to the server log — the default for development.
MAIL_DRIVER="console"
# RESEND_API_KEY="re_..."
MAIL_FROM="Estate <onboarding@resend.dev>"
# Agency inbox that receives property-submission notifications (inquiries go to
# siteConfig.contact.email).
MAIL_TO="office@example.bg"

# --- Rate limiting ----------------------------------------------------------
# Optional. Without these the app falls back to a single-instance in-memory
# limiter, which is fine locally but NOT sufficient for serverless production.
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# The ONE header that carries the real visitor IP. It must be a header your edge
# overwrites on every request, otherwise visitors can spoof it to dodge rate limits.
#   x-real-ip         Vercel, or the bundled Caddyfile (default)
#   cf-connecting-ip  only if Cloudflare proxies the site AND the origin
#                     (*.vercel.app / server IP) is not reachable directly
#   x-forwarded-for   a proxy that replaces or appends it (right-most entry is used)
CLIENT_IP_HEADER="x-real-ip"

# --- Secrets ----------------------------------------------------------------
# Required in production. If any is missing or still one of the example values
# published in this repository, the app logs which one at startup and answers
# every request with an error until it is fixed.
# Salt for hashing visitor IPs before they are stored (GDPR data minimisation).
IP_HASH_SALT="change-me-random-32-chars-minimum"
# Signs draft-preview links shared with property owners.
PREVIEW_TOKEN_SECRET="change-me-random-32-chars-minimum"

# --- Property submissions -------------------------------------------------
# Cloudflare Turnstile (free captcha) for the "List your property" form. Works
# with any domain — DNS does not need to be on Cloudflare. Both keys or neither.
# Cloudflare's always-pass test keys for local development:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Protects /api/cron/* (daily cleanup of old submissions). Vercel Cron sends it
# automatically; on a VPS call the endpoint with `Authorization: Bearer <value>`.
# Generate with: openssl rand -hex 32
# CRON_SECRET=""

# --- Maps -------------------------------------------------------------------
# OpenFreeMap needs no API key. Swap for MapTiler/Mapbox by changing this URL.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/bright"

# --- Observability ----------------------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
